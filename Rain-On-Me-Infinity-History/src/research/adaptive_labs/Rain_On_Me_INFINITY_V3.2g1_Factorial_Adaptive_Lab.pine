indicator(title="Rain On Me ∞ V3.2g1 — Factorial Adaptive Lab",
     shorttitle="ROM 3.2g1",
     overlay=true,
     max_bars_back=1500,
     max_lines_count=200,
     max_labels_count=100,
     max_boxes_count=100)

